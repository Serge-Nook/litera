<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata (software centres, Flathub). Template: package.sh and the Flatpak
     manifest substitute @VERSION@ and @DATE@ from Cargo.toml and the build date. -->
<component type="desktop-application">
  <id>ru.nookbat.litera</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <name>Литера</name>
  <summary>Free software for creating and editing documents</summary>
  <summary xml:lang="ru">Бесплатная программа для создания и редактирования документов</summary>
  <developer id="ru.nookbat">
    <name>Горшков Сергей Владимирович</name>
  </developer>
  <description>
    <p>
      Литера is a free word processor for creating and editing documents: styles, tables, track changes, references, and .docx, PDF, ODT, RTF, HTML and Markdown files.
    </p>
  </description>
  <launchable type="desktop-id">ru.nookbat.litera.desktop</launchable>
  <icon type="stock">ru.nookbat.litera</icon>
  <!-- Only url types known to appstream 0.15 (Ubuntu 22.04, where CI validates): no vcs-browser. -->
  <url type="homepage">https://nookbat.ru</url>
  <url type="bugtracker">https://github.com/Serge-Nook/litera/issues</url>
  <categories>
    <category>Office</category>
    <category>WordProcessor</category>
  </categories>
  <keywords>
    <keyword>word processor</keyword>
    <keyword>docx</keyword>
    <keyword>document</keyword>
    <keyword>writer</keyword>
  </keywords>
  <branding>
    <color type="primary" scheme_preference="light">#b9c7f5</color>
    <color type="primary" scheme_preference="dark">#2b47b5</color>
  </branding>
  <requires>
    <display_length compare="ge">760</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>tablet</control>
  </supports>
  <!-- Document types Литера opens (#295), as in the desktop entry's MimeType=. -->
  <provides>
    <binary>litera</binary>
    <mediatype>application/vnd.openxmlformats-officedocument.wordprocessingml.document</mediatype>
    <mediatype>application/vnd.ms-word.document.macroEnabled.12</mediatype>
    <mediatype>application/vnd.openxmlformats-officedocument.wordprocessingml.template</mediatype>
    <mediatype>application/vnd.ms-word.template.macroEnabled.12</mediatype>
    <mediatype>application/msword</mediatype>
    <mediatype>application/msword-template</mediatype>
    <mediatype>application/vnd.oasis.opendocument.text</mediatype>
    <mediatype>application/rtf</mediatype>
  </provides>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
